{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cf-blog",
  "main": "only/worker.js",
  "no_bundle": true,
  "compatibility_date": "2026-11-01",
  "d1_databases": [
    { "binding": "DB", "database_name": "personal-blog", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }
  ]
}
